NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
SITE_ADDRESS=http://localhost
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://aura:aura_dev_password@localhost:5432/aura_exchange
SESSION_SECRET=replace-with-at-least-32-random-characters
SETUP_TOKEN=replace-with-a-one-time-owner-setup-token
# /v1: signs access tokens and keys the sign-in code hashes (at least 32 random characters)
AUTH_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=fake
OPENAI_API_KEY=
AI_MODEL=gpt-6-astra
WORKER_POLL_MS=2000
TZ=America/New_York
# /v1: app builds below this get 426 UPDATE_REQUIRED
MIN_APP_BUILD=1
# /v1: while set and in the future, every route but /health answers 503 MAINTENANCE (ISO 8601)
MAINTENANCE_UNTIL=
