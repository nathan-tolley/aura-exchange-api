{
  "name": "aura-exchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "preview:mock": "concurrently -k -n mock,web -c yellow,magenta \"tsx scripts/mock-api.ts\" \"vite --config web/vite.config.ts\"",
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist-api/src/server.js",
    "worker": "node dist-api/src/worker.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist-api/scripts/migrate.js",
    "seed": "tsx scripts/seed.ts",
    "pilot:reset": "tsx scripts/pilot-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "argon2": "0.45.1",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "jose": "6.1.0",
    "openai": "7.43.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "9.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
